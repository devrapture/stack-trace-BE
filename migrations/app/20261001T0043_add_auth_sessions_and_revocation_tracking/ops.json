      {
        "description": "create table \"auth_sessions\"",
        "sql": "CREATE TABLE \"public\".\"auth_sessions\" (\n  \"client_type\" text NOT NULL,\n  \"created_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"device_name\" text,\n  \"expires_at\" timestamptz(3) NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"last_used_at\" timestamptz(3) NOT NULL,\n  \"previous_token_hash\" text,\n  \"refresh_token_hash\" text NOT NULL,\n  \"revoked_at\" timestamptz(3),\n  \"revoked_reason\" text,\n  \"updated_at\" timestamptz NOT NULL,\n  \"user_id\" uuid NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"auth_sessions_client_type_check_a9640be8\" CHECK (\"client_type\" IN ('WEB', 'IOS', 'ANDROID', 'OTHER')),\n  CONSTRAINT \"auth_sessions_revoked_reason_check_33704d4a\" CHECK (\"revoked_reason\" IN ('LOGOUT', 'LOGOUT_ALL', 'REUSE_DETECTED', 'PASSWORD_CHANGE', 'SESSION_LIMIT_EXCEEDED', 'ADMIN'))\n)",
        "params": []
      }
    ],
    "postcheck": [
