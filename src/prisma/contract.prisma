// use prisma-8
enum UserStatus {
  PENDING // registered but email not verified
  ACTIVE // verified and usable
  SUSPENDED // disabled by admin
  DELETED // soft-deleted for GDPR
}

enum UserRole {
  USER
  ADMIN
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  GITHUB
}

enum EmailVerificationPurpose {
  REGISTRATION
}

model User {
  id          Uuid                 @id @default(uuid())
  publicId    Uuid                 @unique @default(uuid())
  displayName String?               @map("display_name")
  avatarUrl   String?              @map("avatar_url")
  role        UserRole             @default(USER)
  status      UserStatus           @default(PENDING)
  lastLoginAt Timestamptz(3)?      @map("last_login_at")
  createdAt   temporal.createdAt() @map("created_at")
  updatedAt   temporal.updatedAt() @map("updated_at")

  email       UserEmail[]

  @@map("users")
}

model UserEmail {
  id              Uuid                 @id @default(uuid())
  userId          Uuid                 @map("user_id")
  email           String
  normalizedEmail String               @map("normalized_email")
  isPrimary       Boolean              @map("is_primary") @default(false)
  verifiedAt      Timestamptz(3)?      @map("verified_at")
  createdAt       temporal.createdAt() @map("created_at")
  updatedAt       temporal.updatedAt() @map("updated_at")
  user            User                 @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@unique([normalizedEmail])
  // At most one primary email per user
  @@index([userId], unique: true, where: "is_primary = true",name: "user_emails_user_idx")

  @@map("user_emails")
}

model AuthIdentity {
  id             Uuid                 @id @default(uuid())
  userId         Uuid                 @map("user_id")
  provider       AuthProvider
  providerSubject String?      @map("provider_subject")

  createdAt      temporal.createdAt() @map("created_at")
  updatedAt      temporal.updatedAt() @map("updated_at")

  passwordCredential PasswordCredential?
  user           User                 @relation(fields:[userId], references:[id], onDelete: Cascade)

  @@unique([userId, provider])
  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("auth_identities")
}

model PasswordCredential {
  id Uuid @id @default(uuid())
  passwordHash String @map("password_hash")
  authIdentityId Uuid @unique() @map("auth_identity_id") 
  
  createdAt temporal.createdAt() @map("created_at")
  updatedAt temporal.updatedAt() @map("updated_at")

  authIdentity AuthIdentity @relation(fields:[authIdentityId], references:[id], onDelete:Cascade)

  @@map("password_credential")
}

model EmailVerificationChallenge {
  id Uuid @id @default(uuid())
  userId Uuid @map("user_id")
  purpose EmailVerificationPurpose
  otpHash String @map("otp_hash")
  expiresAt Timestamptz(3) @map("expires_at")
  attemptCount Int @map("attempt_count")
  maxAttempts Int @map("max_attempts")
  consumedAt Timestamptz(3)? @map("consumed_at")

  createdAt      temporal.createdAt() @map("created_at")
  updatedAt      temporal.updatedAt() @map("updated_at")

  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId,purpose])
  @@map("email_verification_challenges")
}
