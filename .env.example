# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL="postgresql://stack_trace:local-development-only@localhost:5432/stack_trace?schema=public"
# Secret used to hash OTP values. Use a long, randomly generated value.
OTP_HASH_SECRET=change-me-to-a-secure-random-secret

# Resend API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Verified sender email/domain configured in Resend.
RESEND_FROM_EMAIL=noreply@example.com

# Display name shown to email recipients.
RESEND_FROM_NAME=Example App

# JWT configuration

# JWT key ID used to identify which signing key is active
JWT_KID=

# Private key used to sign JWT access tokens
JWT_PRIVATE_KEY=

# Public key used to verify JWT access tokens
JWT_PUBLIC_KEY=
